{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/api/regions/:region/roads", "destination": "/geometry/:region/roads.json" },
    { "source": "/api/regions/:region/buildings", "destination": "/geometry/:region/buildings.json" },
    { "source": "/api/regions", "destination": "/geometry/regions.json" },
    { "source": "/api/regions/:region/meta", "destination": "/geometry/:region/meta.json" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/readyz", "destination": "/api/index" },
    { "source": "/simulator", "destination": "/simulator/index.html" }
  ]
}
