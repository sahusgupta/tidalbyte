    },
    "Interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "clarifications"
      ],
      "properties": {
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandProposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "clarifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 10
        }
      },
      "title": "Interpretation"
    },
    "VoiceSpeakRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "title": "VoiceSpeakRequest"
    }
