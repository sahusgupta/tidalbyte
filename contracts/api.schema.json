        "disabledEdgeIds",
        "interventions"
      ],
      "properties": {
        "regionId": {
          "const": "houston-gulf-coast"
        },
        "disabledNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 100
        },
        "disabledEdgeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 100
        },
        "interventions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "minItems": 0,
          "maxItems": 3
        }
