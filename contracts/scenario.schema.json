{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/earthlab/scenario.v1.schema.json",
  "title": "Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "regionId",
    "presetEventId",
    "scenarioVersion",
    "selection",
    "modelMode"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "regionId": {
      "const": "houston-gulf-coast"
    },
    "presetEventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scenarioVersion": {
      "type": "integer",
      "minimum": 1
    },
    "selection": {
      "type": "object",
      "required": [
        "countyFips",
        "warningTypes",
        "eventTimeUtc"
      ],
      "additionalProperties": false,
      "properties": {
        "countyFips": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "warningTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "eventTimeUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "title": "ScenarioSelection"
    },
    "modelMode": {
      "enum": [
        "historical_context",
        "exploratory_what_if"
      ]
    },
    "perturbations": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 16
    }
  }
}
